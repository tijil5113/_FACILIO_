# Leave empty to use the Vite development proxy (/api -> Flask).
VITE_API_BASE_URL=

# Production Docker / Railway: this is build-time configuration for the SPA.
# Example: VITE_API_BASE_URL=https://<public-backend-origin>
# Compose default is http://localhost:5050 (see docker-compose.yml).

# Used only by the Vite proxy. Override if the API is not on 5050.
VITE_PROXY_TARGET=http://127.0.0.1:5050
