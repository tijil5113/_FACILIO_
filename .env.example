# FACILIO environment template
# Copy to the repository-root `.env` (untracked). That file is the only
# local environment file the API and worker load.
# Do not create apps/api/.env — it is ignored at runtime.

# --- Application ---
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-string
LOG_LEVEL=INFO
MAX_CONTENT_LENGTH=18874368
MAX_UPLOAD_SIZE_MB=16
PREVIEW_MAX_ROWS=100
PREVIEW_MAX_COLUMNS=200
PROFILE_TOP_VALUES_LIMIT=10
PROFILE_EVIDENCE_LIMIT=8
PROFILE_HISTOGRAM_BINS=10
PROFILE_DUPLICATE_GROUPS_LIMIT=5

# --- Database (PostgreSQL) ---
# SQLAlchemy URL. Use the psycopg v3 driver for PostgreSQL.
DATABASE_URL=postgresql+psycopg://facilio:facilio_dev@localhost:5432/facilio

# Compose-only PostgreSQL bootstrap (must match DATABASE_URL when using Docker)
POSTGRES_USER=facilio
POSTGRES_PASSWORD=facilio_dev
POSTGRES_DB=facilio

# --- CORS ---
# Comma-separated browser origins. Production rejects "*" .
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Asynchronous jobs (Redis / RQ) ---
REDIS_URL=redis://localhost:6379/0
JOB_QUEUE_NAME=workflows
MAX_JOB_ATTEMPTS=3
JOB_STALE_SECONDS=90
WORKER_HEARTBEAT_SECONDS=30

# --- Frontend (apps/web/.env, Vite only) ---
# Leave empty to use the Vite development proxy to the API.
# VITE_API_BASE_URL=
# VITE_PROXY_TARGET=http://127.0.0.1:5050
